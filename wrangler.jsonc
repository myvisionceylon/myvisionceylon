// Cloudflare config: serves the built site (the dist/ folder) as static files.
// Used when the project is set up through Cloudflare "Workers" with
// build command `npm run build` and deploy command `npx wrangler deploy`.
{
  "name": "myvisionceylon",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
