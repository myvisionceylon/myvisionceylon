---
// Layout for src/pages/about.md: a "whoami" card plus your own writing.
import Base from './Base.astro';
import { SITE } from '../site.config';

const links = [
  SITE.linkedin && { label: 'linkedin', href: SITE.linkedin, note: 'work & background' },
  { label: 'github', href: SITE.github, note: 'every edit, dated in public' },
  { label: 'blog', href: SITE.blog, note: 'Imaginatiodec' },
  { label: 'contact', href: '/submit/', note: 'email address on the submit page' },
].filter(Boolean) as { label: string; href: string; note: string }[];
---

<Base title="About" description={`About ${SITE.author} and ${SITE.name}.`} path="~/about" nav="about">
  <a class="back" href="/">&lt;- cd ..</a>
  <div class="prompt" style="margin-top: 24px">$ whoami</div>
  <h1 class="title">{SITE.author}<span class="cursor" style="color: var(--accent)">_</span></h1>

  <div class="layout-2col">
    <article class="primary prose">
      <slot />
    </article>

    <aside class="secondary" aria-label="Links">
      <div class="panel">
        <div class="panel-head">[ links ]</div>
        <ul class="links">
          {
            links.map((l) => (
              <li>
                <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
                  &gt; {l.label}
                </a>
                <span>{l.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="dashed" style="font-size: 13px">
        <div class="prompt" style="font-size: 13px">$ cat /etc/motd</div>
        <p style="margin: 6px 0 0">
          Ideas here are mine unless marked <span style="color: var(--community)">● COMMUNITY</span>. Share them freely,
          with credit, under <a href={SITE.licenseUrl}>{SITE.license}</a>.
        </p>
      </div>
    </aside>
  </div>
</Base>

<style>
  .links {
    list-style: none;
    margin: 0;
    padding: 6px 12px 12px;
  }
  .links li {
    padding: 8px 0;
    border-bottom: 1px dashed var(--line);
    display: flex;
    flex-direction: column;
  }
  .links li:last-child {
    border-bottom: none;
  }
  .links span {
    color: var(--text-dim);
    font-size: 12px;
  }
</style>
