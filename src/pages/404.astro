---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="prompt">$ cd {Astro.url.pathname}</div>
  <h1 class="title">bash: no such vision<span class="cursor" style="color: var(--accent)">_</span></h1>
  <p class="lede">This page doesn't exist yet. Maybe it's still only a dream.</p>
  <p style="margin-top: 24px"><a class="btn" href="/">&gt; cd ~</a></p>
</Base>
